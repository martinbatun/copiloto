{
  "name": "@copiloto/agent-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3500 tsx watch --include '../../../packages/**/src/**/*.ts' --include '../../packages/**/src/**/*.ts' server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@copiloto/agent-shared": "workspace:*",
    "@copiloto/auth": "workspace:*",
    "@prisma/client": "^6.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@copiloto/agent-ts-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "prisma": "^6.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0"
  }
}
