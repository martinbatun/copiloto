NODE_ENV=development
PORT=3500
CORS_ORIGIN=http://localhost:5500

# Agent DB (separada del core)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copiloto_agent?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/copiloto_agent?schema=public

# Auth (JWT compartido con el core para SSO)
JWT_SECRET=replace-me-with-the-same-as-core

# WhatsApp Business API (Meta Cloud API)
WBA_PHONE_NUMBER_ID=
WBA_BUSINESS_ACCOUNT_ID=
WBA_TOKEN=
WBA_VERIFY_TOKEN=replace-me
WBA_GRAPH_VERSION=v21.0

# LLM (agente conversacional FOH + co-piloto WhatsApp)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Core API
CORE_API_URL=http://localhost:3400
CORE_API_KEY=replace-me-internal-shared-secret
