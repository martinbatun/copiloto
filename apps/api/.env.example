# --- Core API ---
NODE_ENV=development
PORT=3400
# Lista separada por comas si hay varios orígenes (dominio propio + vercel.app).
CORS_ORIGIN=http://localhost:5400
# "true" permite los preview deploys de Vercel del proyecto (QA por PR).
CORS_ALLOW_VERCEL_PREVIEWS=false
# URLs públicas usadas por el checkout de pago (back_urls) y el webhook de MP.
PUBLIC_WEB_URL=http://localhost:5400
PUBLIC_API_URL=http://localhost:3400
# Rate limit por IP/min (backstop anti-DoS). Generoso porque los comensales
# comparten IP (NAT del WiFi). Health y webhook de MP quedan exentos.
RATE_LIMIT_PER_MIN=300

# --- Database (Supabase / Postgres) ---
# DATABASE_URL: runtime de la app. En Supabase usa el POOLER (puerto 6543,
#   ?pgbouncer=true) para soportar muchas conexiones.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copiloto?schema=public
# DIRECT_URL: conexión DIRECTA (puerto 5432, host db.<ref>.supabase.co), NO el
#   pooler. Prisma la usa para migraciones (migrate dev/deploy); el pooler no
#   soporta el advisory lock ni el DDL que requieren. Ver docs/MIGRACIONES.md.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/copiloto?schema=public

# --- Auth ---
JWT_SECRET=replace-me-with-a-32-byte-random-string

# --- Supabase Storage (uploads: facturas OCR, logos, fotos) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=copiloto-uploads

# --- Monitoreo (opcional) ---
# Con SENTRY_DSN puesto, la API reporta errores no manejados a Sentry.
# Sin él, el monitoreo queda desactivado (dev/staging funcionan igual).
SENTRY_DSN=
SENTRY_TRACES_RATE=0

# --- AI ---
# Co-piloto conversacional. Sin la key, /api/copilot/chat responde 503.
OPENROUTER_API_KEY=
# Slug de modelo en OpenRouter (ver https://openrouter.ai/models).
OPENROUTER_MODEL=minimax/minimax-m2.7
# Endpoint del servicio de forecast (LightGBM/XGBoost) — Python aparte o sidecar.
FORECAST_SERVICE_URL=http://localhost:9100

# --- POS connectors ---
SOFT_RESTAURANT_API_URL=
SOFT_RESTAURANT_API_KEY=
ONECORE_API_URL=
ONECORE_API_KEY=
CLIP_API_URL=
CLIP_API_KEY=
SQUARE_ACCESS_TOKEN=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=

# --- WhatsApp (apunta al agente) ---
AGENT_API_URL=http://localhost:3500
AGENT_API_KEY=

# --- Pagos ---
# Checkout Pro de Mercado Pago para "Pagar desde el móvil". El pago en línea
# requiere AMBOS: MERCADO_PAGO_TOKEN y MERCADO_PAGO_WEBHOOK_SECRET.
MERCADO_PAGO_TOKEN=
# Clave secreta del webhook (Mercado Pago → Tus Integraciones → Webhooks).
MERCADO_PAGO_WEBHOOK_SECRET=
# Modo simulado de pago (PAID inmediato sin cobrar). OPT-IN solo para dev/staging.
# En producción NO lo actives: sin pasarela, el pago móvil se rechaza (503).
# También se activa automáticamente si NODE_ENV=development.
ALLOW_SIMULATED_PAYMENTS=
STRIPE_SECRET=
