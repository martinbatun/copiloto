{
  "name": "@copiloto/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3400 tsx watch --include '../../packages/**/src/**/*.ts' server/index.ts",
    "build": "prisma generate && tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.mjs",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@copiloto/auth": "workspace:*",
    "@copiloto/shared": "workspace:*",
    "@copiloto/utils": "workspace:*",
    "@prisma/client": "^6.13.0",
    "@sentry/node": "^10.63.0",
    "@supabase/supabase-js": "^2.103.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@copiloto/ts-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "prisma": "^6.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
